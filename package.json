{
  "name": "dsh-deltaforce",
  "version": "0.2.8-preview.1",
  "description": "Local cinematic startup overlay for DeepSeek Harness Desktop",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": ["src/index.js", "dist/client.js", "assets/boot.mp4", "assets/intro.wav", "assets/orbital-finale.png", "assets/prelude-identity.jpg", "cordis.patch.yml", "README.md", "SECURITY.md"],
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "external": ["react"]
    }
  },
  "engines": { "node": ">=22.19" },
  "private": true
}
